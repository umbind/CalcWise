---
import { getRelatedCalculators, getCategoryMetadata, type CategoryId } from '../lib/calculations/registry';

interface Props {
  currentSlug: string;
  category: CategoryId;
  categoryLabel?: string;
}

const { currentSlug, category, categoryLabel } = Astro.props;
const relatedTools = getRelatedCalculators(currentSlug, 3);
const categoryMeta = getCategoryMetadata(category);
const catLabel = categoryLabel || categoryMeta?.name || 'Category';
const categoryCardStyles: Record<string, { bg: string; border: string; text: string; link: string }> = {
  finance: {
    bg: 'bg-gradient-to-br from-blue-50/80 via-white to-indigo-50/50',
    border: 'border-blue-200/90 hover:border-blue-500',
    text: 'text-blue-950 group-hover:text-blue-700',
    link: 'text-blue-700 group-hover:text-blue-900',
  },
  health: {
    bg: 'bg-gradient-to-br from-rose-50/80 via-white to-pink-50/50',
    border: 'border-rose-200/90 hover:border-rose-500',
    text: 'text-rose-950 group-hover:text-rose-700',
    link: 'text-rose-700 group-hover:text-rose-900',
  },
  math: {
    bg: 'bg-gradient-to-br from-purple-50/80 via-white to-violet-50/50',
    border: 'border-purple-200/90 hover:border-purple-500',
    text: 'text-purple-950 group-hover:text-purple-700',
    link: 'text-purple-700 group-hover:text-purple-900',
  },
  construction: {
    bg: 'bg-gradient-to-br from-amber-50/80 via-white to-orange-50/50',
    border: 'border-amber-200/90 hover:border-amber-500',
    text: 'text-amber-950 group-hover:text-amber-700',
    link: 'text-amber-700 group-hover:text-amber-900',
  },
  everyday: {
    bg: 'bg-gradient-to-br from-sky-50/80 via-white to-cyan-50/50',
    border: 'border-sky-200/90 hover:border-sky-500',
    text: 'text-sky-950 group-hover:text-sky-700',
    link: 'text-sky-700 group-hover:text-sky-900',
  },
  converters: {
    bg: 'bg-gradient-to-br from-emerald-50/80 via-white to-teal-50/50',
    border: 'border-emerald-200/90 hover:border-emerald-500',
    text: 'text-emerald-950 group-hover:text-emerald-700',
    link: 'text-emerald-700 group-hover:text-emerald-900',
  },
};
---

<section class="pt-8 border-t border-gray-200" aria-labelledby="related-tools-heading">
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
    <div>
      <h2 id="related-tools-heading" class="text-base font-bold text-brand-dark tracking-tight">
        Related Calculators
      </h2>
      <p class="text-xs text-brand-muted">
        Explore companion tools in {catLabel} and related mathematical domains.
      </p>
    </div>
    {categoryMeta && (
      <a
        href={categoryMeta.route}
        class="text-xs font-semibold text-brand-primary hover:text-brand-accent transition inline-flex items-center space-x-1"
      >
        <span>All {categoryMeta.shortName} Calculators</span>
        <span>→</span>
      </a>
    )}
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
    {relatedTools.map((tool) => {
      const style = categoryCardStyles[tool.category] || categoryCardStyles.finance;
      return (
        <a
          href={tool.route}
          class={`p-3.5 ${style.bg} border ${style.border} rounded-xl hover:shadow-md hover:-translate-y-0.5 transition-all group flex flex-col justify-between`}
        >
          <div>
            <div class="flex items-center space-x-2 mb-1.5">
              <span class="text-base">{tool.icon}</span>
              <span class={`font-bold text-xs ${style.text} transition truncate leading-snug`}>
                {tool.name}
              </span>
            </div>
            <p class="text-xs text-slate-600 line-clamp-2 leading-relaxed">
              {tool.description}
            </p>
          </div>
          <div class="mt-2.5 pt-2 border-t border-gray-100/80 flex items-center justify-between text-[11px]">
            <span class="font-medium text-slate-500">{tool.categoryLabel}</span>
            <span class={`font-bold ${style.link} group-hover:translate-x-0.5 transition-transform`}>
              Calculate →
            </span>
          </div>
        </a>
      );
    })}
  </div>
</section>
