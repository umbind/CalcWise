---
import { CALCULATOR_REGISTRY } from '../lib/calculations/registry';

interface Props {
  title: string;
  description: string;
  breadcrumbs?: Array<{ label: string; href?: string }>;
  canonicalUrl?: string;
}

const { title, description, breadcrumbs = [], canonicalUrl } = Astro.props;

const isHomePage = Astro.url.pathname === '/' || Astro.url.pathname === '';
const currentPath = Astro.url.pathname;

const navCategories = [
  { id: 'finance', name: 'Finance & Money', icon: '💰', count: CALCULATOR_REGISTRY.filter(c => c.category === 'finance').length },
  { id: 'health', name: 'Health & Fitness', icon: '❤️', count: CALCULATOR_REGISTRY.filter(c => c.category === 'health').length },
  { id: 'math', name: 'Math & Algebra', icon: '➗', count: CALCULATOR_REGISTRY.filter(c => c.category === 'math').length },
  { id: 'construction', name: 'Construction & Materials', icon: '🏗️', count: CALCULATOR_REGISTRY.filter(c => c.category === 'construction').length },
  { id: 'everyday', name: 'Everyday & Calendar', icon: '📅', count: CALCULATOR_REGISTRY.filter(c => c.category === 'everyday').length },
  { id: 'converters', name: 'Conversions & Units', icon: '⇄', count: CALCULATOR_REGISTRY.filter(c => c.category === 'converters').length },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | CalcWise</title>
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <meta name="theme-color" content="#0B4F8A" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Security Headers -->
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />

    <!-- OpenGraph Social Metadata -->
    <meta property="og:site_name" content="CalcWise" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} | CalcWise`} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}

    <!-- Twitter Card Metadata -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${title} | CalcWise`} />
    <meta name="twitter:description" content={description} />

    <!-- Print Stylesheet -->
    <style is:inline>
      @media print {
        header, nav, footer, .no-print, [aria-label="Breadcrumbs"] {
          display: none !important;
        }
        body {
          background-color: #ffffff !important;
          color: #0f172a !important;
        }
        main {
          max-width: 100% !important;
          padding: 0 !important;
          margin: 0 !important;
        }
        .print-only {
          display: block !important;
        }
        .break-inside-avoid {
          break-inside: avoid !important;
          page-break-inside: avoid !important;
        }
      }
      @media screen {
        .print-only {
          display: none !important;
        }
      }
    </style>
  </head>
  <body class="min-h-screen bg-brand-surface text-brand-dark font-sans flex flex-col antialiased">
    <!-- Accessible Skip to Content -->
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 z-50 bg-brand-primary text-white px-4 py-2 rounded-md shadow-lg outline-none ring-2 ring-white"
    >
      Skip to main content
    </a>

    <!-- Top Navigation Header -->
    <header class="bg-white border-b border-brand-border sticky top-0 z-40 no-print">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <div class="flex items-center space-x-6">
          <a href="/" class="flex items-center space-x-2.5 focus:outline-none focus:ring-2 focus:ring-brand-primary rounded p-1">
            <div class="w-8 h-8 rounded-lg bg-brand-primary flex items-center justify-center text-white font-bold text-lg shadow-sm">
              CW
            </div>
            <span class="text-xl font-bold tracking-tight text-brand-primary">CalcWise</span>
          </a>
          <nav class="hidden md:flex items-center space-x-1" aria-label="Main Navigation">
            <a href="/finance" class="px-2.5 py-1.5 text-xs font-semibold text-brand-muted hover:text-brand-primary rounded-md hover:bg-brand-surface transition">Finance</a>
            <a href="/health" class="px-2.5 py-1.5 text-xs font-semibold text-brand-muted hover:text-brand-primary rounded-md hover:bg-brand-surface transition">Health</a>
            <a href="/math" class="px-2.5 py-1.5 text-xs font-semibold text-brand-muted hover:text-brand-primary rounded-md hover:bg-brand-surface transition">Math</a>
            <a href="/construction" class="px-2.5 py-1.5 text-xs font-semibold text-brand-muted hover:text-brand-primary rounded-md hover:bg-brand-surface transition">Construction</a>
            <a href="/everyday" class="px-2.5 py-1.5 text-xs font-semibold text-brand-muted hover:text-brand-primary rounded-md hover:bg-brand-surface transition">Everyday</a>
            <a href="/converters" class="px-2.5 py-1.5 text-xs font-semibold text-brand-muted hover:text-brand-primary rounded-md hover:bg-brand-surface transition">Converters</a>
          </nav>
        </div>

        <div class="flex items-center space-x-3">
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 mr-1.5"></span>
            Verified Math Engine
          </span>
        </div>
      </div>
      <!-- Mobile Sub-Navigation Bar -->
      <div class="md:hidden flex overflow-x-auto px-4 py-2 border-t border-gray-100 bg-white gap-3 text-xs font-semibold text-brand-muted no-scrollbar">
        <a href="/finance" class="whitespace-nowrap hover:text-brand-primary">Finance</a>
        <a href="/health" class="whitespace-nowrap hover:text-brand-primary">Health</a>
        <a href="/math" class="whitespace-nowrap hover:text-brand-primary">Math</a>
        <a href="/construction" class="whitespace-nowrap hover:text-brand-primary">Construction</a>
        <a href="/everyday" class="whitespace-nowrap hover:text-brand-primary">Everyday</a>
        <a href="/converters" class="whitespace-nowrap hover:text-brand-primary">Converters</a>
      </div>
    </header>

    <!-- Breadcrumb Bar -->
    {breadcrumbs.length > 0 && (
      <nav aria-label="Breadcrumbs" class="bg-white border-b border-gray-100 text-xs py-2 px-4 sm:px-6 lg:px-8">
        <div class="max-w-7xl mx-auto flex items-center space-x-2 text-brand-muted">
          <a href="/" class="hover:text-brand-primary">Home</a>
          {breadcrumbs.map((crumb) => (
            <>
              <span class="text-gray-300">/</span>
              {crumb.href ? (
                <a href={crumb.href} class="hover:text-brand-primary">{crumb.label}</a>
              ) : (
                <span class="font-medium text-brand-dark" aria-current="page">{crumb.label}</span>
              )}
            </>
          ))}
        </div>
      </nav>
    )}

    <!-- Main Body Area -->
    <main id="main-content" class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <!-- Print-Only Document Header -->
      <div class="print-only border-b-2 border-brand-primary pb-4 mb-6">
        <div class="flex justify-between items-end">
          <div>
            <div class="text-2xl font-black tracking-tight text-brand-primary">CalcWise</div>
            <div class="text-xs text-gray-600">Verifiable Calculation Platform & Methodological Passports</div>
          </div>
          <div class="text-right text-xs text-gray-500 font-mono">
            <div>https://calcwise.webcalcapps.workers.dev</div>
            <div>Verified Calculation Report</div>
          </div>
        </div>
      </div>

      <!-- Mini Category Navigation Strip (Shown on all pages except Homepage) -->
      {!isHomePage && (
        <div class="no-print mb-6 -mt-2">
          <div class="flex items-center justify-between mb-2">
            <span class="text-[11px] font-bold uppercase tracking-wider text-gray-400">All Categories</span>
            <a href="/" class="text-[11px] text-brand-primary hover:underline flex items-center gap-1 font-medium">
              <span>View All 50 Tools</span>
              <span>→</span>
            </a>
          </div>
          <div class="flex overflow-x-auto gap-2 pb-1 sm:grid sm:grid-cols-3 lg:grid-cols-6 no-scrollbar">
            {navCategories.map((cat) => {
              const isActive = currentPath.startsWith(`/${cat.id}`);
              return (
                <a
                  href={`/${cat.id}`}
                  class={`flex items-center space-x-2 px-3 py-2 rounded-xl border text-left transition shrink-0 sm:shrink ${
                    isActive
                      ? 'bg-blue-50/80 border-brand-primary text-brand-primary font-semibold shadow-2xs ring-1 ring-brand-primary/20'
                      : 'bg-white border-brand-border text-brand-dark hover:border-brand-primary/40 hover:bg-gray-50/80 shadow-2xs'
                  }`}
                >
                  <span class="text-base">{cat.icon}</span>
                  <div class="min-w-0">
                    <div class="text-xs font-bold truncate leading-tight">{cat.name}</div>
                    <div class="text-[10px] text-gray-400 leading-tight mt-0.5">{cat.count} Tools</div>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      )}

      <slot />

      <!-- Print-Only Document Footer -->
      <div class="print-only mt-12 pt-4 border-t border-gray-300 text-[10px] text-gray-500 flex justify-between">
        <span>Printed from CalcWise (https://calcwise.webcalcapps.workers.dev)</span>
        <span>Deterministic Math & WCAG 2.2 AA Verified</span>
      </div>
    </main>

    <!-- Footer -->
    <footer class="bg-white border-t border-brand-border py-12 mt-16 text-sm text-brand-muted no-print">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <!-- Column 1: Brand & Mission -->
          <div class="md:col-span-1 space-y-3">
            <div class="flex items-center space-x-2">
              <div class="w-7 h-7 rounded bg-brand-primary text-white flex items-center justify-center font-bold text-xs shadow-2xs">CW</div>
              <span class="font-bold text-base text-brand-dark">CalcWise</span>
            </div>
            <p class="text-xs text-brand-muted leading-relaxed">
              Fast, deterministic calculations with inspectable Calculation Passports, step-by-step mathematical traces, and zero-JS performance.
            </p>
            <div class="text-[11px] text-gray-400">
              Built on Astro Islands & Decimal Precision.
            </div>
          </div>

          <!-- Column 2: Category Hubs -->
          <div>
            <div class="text-xs font-bold uppercase tracking-wider text-brand-dark mb-3">Categories</div>
            <ul class="space-y-2 text-xs">
              <li><a href="/finance" class="hover:text-brand-primary">Personal Finance & Loans</a></li>
              <li><a href="/health" class="hover:text-brand-primary">Health & Metabolic Screening</a></li>
              <li><a href="/math" class="hover:text-brand-primary">Math, Algebra & Statistics</a></li>
              <li><a href="/construction" class="hover:text-brand-primary">Construction & Materials</a></li>
              <li><a href="/everyday" class="hover:text-brand-primary">Everyday & Calendar Utilities</a></li>
              <li><a href="/converters" class="hover:text-brand-primary">Measurement & Unit Converters</a></li>
            </ul>
          </div>

          <!-- Column 3: Featured Financial & Health Calculators -->
          <div>
            <div class="text-xs font-bold uppercase tracking-wider text-brand-dark mb-3">Finance & Health</div>
            <ul class="space-y-2 text-xs">
              <li><a href="/finance/emi-calculator" class="hover:text-brand-primary">EMI / Loan Payment Calculator</a></li>
              <li><a href="/finance/compound-interest-calculator" class="hover:text-brand-primary">Compound Interest Calculator</a></li>
              <li><a href="/finance/mortgage-calculator" class="hover:text-brand-primary">Mortgage Payment Calculator</a></li>
              <li><a href="/health/bmi-calculator" class="hover:text-brand-primary">Adult BMI Calculator</a></li>
              <li><a href="/health/calorie-calculator" class="hover:text-brand-primary">Calorie & TDEE Calculator</a></li>
            </ul>
          </div>

          <!-- Column 4: Featured Math & Utility Calculators -->
          <div>
            <div class="text-xs font-bold uppercase tracking-wider text-brand-dark mb-3">Math & Materials</div>
            <ul class="space-y-2 text-xs">
              <li><a href="/math/percentage-calculator" class="hover:text-brand-primary">Percentage Calculator</a></li>
              <li><a href="/math/scientific-calculator" class="hover:text-brand-primary">Scientific Calculator</a></li>
              <li><a href="/construction/concrete-calculator" class="hover:text-brand-primary">Concrete Volume Calculator</a></li>
              <li><a href="/everyday/age-calculator" class="hover:text-brand-primary">Chronological Age Calculator</a></li>
              <li><a href="/converters/unit-converter" class="hover:text-brand-primary">Universal Unit Converter</a></li>
            </ul>
          </div>
        </div>

        <div class="pt-6 border-t border-gray-100 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-gray-400">
          <div>
            &copy; 2026 CalcWise. Pure mathematical decoupling & WCAG 2.2 AA compliant.
          </div>
          <div class="flex space-x-6 text-brand-muted">
            <a href="/" class="hover:text-brand-primary">Discovery Hub</a>
            <a href="/finance" class="hover:text-brand-primary">Finance</a>
            <a href="/health" class="hover:text-brand-primary">Health</a>
            <a href="/math" class="hover:text-brand-primary">Math</a>
            <a href="/construction" class="hover:text-brand-primary">Construction</a>
            <a href="/everyday" class="hover:text-brand-primary">Everyday</a>
            <a href="/converters" class="hover:text-brand-primary">Converters</a>
          </div>
        </div>
      </div>
    </footer>
  </body>
</html>
