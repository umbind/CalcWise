---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCategoryMetadata, getCalculatorsByCategory } from '../../lib/calculations/registry';

const category = getCategoryMetadata('construction');
if (!category) throw new Error('Category metadata for construction not found');

const calculators = getCalculatorsByCategory('construction');

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: category.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${category.name} - CalcWise`,
  description: category.description,
  url: `https://calcwise.webcalcapps.workers.dev${category.route}/`,
  hasPart: calculators.map((calc) => ({
    '@type': 'WebApplication',
    name: calc.name,
    url: `https://calcwise.webcalcapps.workers.dev${calc.route}/`,
    applicationCategory: 'UtilityApplication',
    operatingSystem: 'All',
  })),
};
---

<BaseLayout
  title={`${category.name}: Concrete, Square Footage & Paint Tools`}
  description={category.description}
  breadcrumbs={[{ label: category.shortName }]}
  canonicalUrl={`https://calcwise.webcalcapps.workers.dev${category.route}/`}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />

  <div class="max-w-5xl mx-auto space-y-12">
    <!-- Category Hero Header -->
    <header class="text-center sm:text-left border-b border-gray-200 pb-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
        <div class="flex items-center space-x-3 justify-center sm:justify-start">
          <span class="text-4xl p-2.5 bg-white border border-brand-border rounded-2xl shadow-2xs">
            {category.icon}
          </span>
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-brand-primary">
              Category Hub
            </span>
            <h1 class="text-2xl sm:text-3xl font-black text-brand-dark tracking-tight">
              {category.name}
            </h1>
          </div>
        </div>

        <div class="flex items-center space-x-2 self-center sm:self-auto">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
            <span class="w-2 h-2 rounded-full bg-emerald-500 mr-1.5"></span>
            {calculators.length} Trade Estimators
          </span>
          <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-800 border border-amber-200">
            Tier T1 Physical Material
          </span>
        </div>
      </div>

      <p class="text-base text-brand-muted leading-relaxed max-w-3xl">
        {category.description}
      </p>
    </header>

    <!-- Calculator Grid -->
    <section aria-labelledby="tools-list-heading">
      <div class="flex justify-between items-baseline mb-6">
        <h2 id="tools-list-heading" class="text-xl font-bold text-brand-dark tracking-tight">
          Materials & Surface Calculators
        </h2>
        <span class="text-xs text-brand-muted font-medium">ACI Standards & Waste Factors</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3.5">
        {calculators.map((calc) => (
          <a
            href={calc.route}
            class="bg-gradient-to-br from-amber-50/80 via-white to-orange-50/50 border border-amber-200/90 rounded-xl p-4 hover:border-amber-500 hover:shadow-md hover:-translate-y-0.5 transition-all flex flex-col justify-between group"
          >
            <div>
              <div class="flex items-start justify-between gap-2 mb-2">
                <div class="flex items-center space-x-2.5 min-w-0">
                  <span class="w-8 h-8 rounded-lg bg-amber-100 text-amber-800 flex items-center justify-center text-base shrink-0 group-hover:scale-110 transition-transform shadow-2xs">
                    {calc.icon}
                  </span>
                  <div class="min-w-0">
                    <h3 class="font-bold text-sm text-amber-950 group-hover:text-amber-700 transition truncate leading-snug">
                      {calc.name}
                    </h3>
                    <span class="text-[10px] font-mono text-amber-400 block -mt-0.5">
                      ID: {calc.id}
                    </span>
                  </div>
                </div>
                <span class="px-1.5 py-0.5 text-[9px] font-extrabold rounded bg-amber-100 text-amber-800 border border-amber-200 shrink-0">
                  {calc.riskTier}
                </span>
              </div>

              <p class="text-xs text-slate-600 leading-relaxed line-clamp-2 mb-3">
                {calc.description}
              </p>
            </div>

            <div class="pt-2 border-t border-amber-100/80 flex items-center justify-between text-xs font-bold text-amber-700 group-hover:text-amber-900">
              <span class="text-[11px] font-medium text-slate-500">Volumetric Estimator</span>
              <span class="inline-flex items-center">
                Calculate <span class="ml-1 group-hover:translate-x-0.5 transition-transform">→</span>
              </span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- Construction Methodologies & Standards -->
    <section class="bg-white rounded-2xl border border-brand-border p-6 sm:p-8 space-y-6 shadow-2xs">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-brand-primary">
          Trade Standards & Estimating Principles
        </span>
        <h2 class="text-xl font-black text-brand-dark tracking-tight mt-1">
          Accurate Dimensional Yields Without Waste
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs text-brand-dark leading-relaxed">
        <div class="space-y-3">
          <h3 class="font-bold text-sm text-brand-dark">The Necessity of Waste Allowances</h3>
          <p class="text-brand-muted">
            In physical building projects, actual material consumption always exceeds theoretical geometric formulas. Subgrade ground variations, lumber formwork bowing, blade kerf cuts on flooring, and roller absorption for paint routinely consume 5% to 15% extra material.
          </p>
          <p class="text-brand-muted">
            CalcWise incorporates explicit, adjustable waste margins into every construction calculator, outputting exact bag, can, and raw volumetric yields with rounding up to the nearest whole sellable unit.
          </p>
        </div>

        <div class="space-y-3">
          <h3 class="font-bold text-sm text-brand-dark">American Concrete Institute (ACI) Yields</h3>
          <p class="text-brand-muted">
            One cubic yard is 27 cubic feet (46,656 cubic inches). Standard pre-mixed dry bags are formulated to exact densities:
          </p>
          <ul class="list-disc pl-4 space-y-1 text-brand-muted text-[11px]">
            <li>80 lb bag: 0.60 cu ft yield (45 bags / cu yd)</li>
            <li>60 lb bag: 0.45 cu ft yield (60 bags / cu yd)</li>
            <li>50 lb bag: 0.375 cu ft yield (72 bags / cu yd)</li>
          </ul>
          <div class="p-3.5 bg-brand-surface rounded-xl border border-gray-200 mt-2">
            <span class="font-semibold text-brand-dark block mb-1">Governing Standards:</span>
            <span class="text-brand-muted text-[11px] block">{category.standardsBody}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Category FAQs -->
    <section class="space-y-4" aria-labelledby="category-faq-heading">
      <h2 id="category-faq-heading" class="text-xl font-bold text-brand-dark tracking-tight">
        Frequently Asked Questions
      </h2>

      <div class="space-y-3">
        {category.faqs.map((faq) => (
          <div class="bg-white border border-brand-border rounded-xl p-5 shadow-2xs">
            <h3 class="font-bold text-sm text-brand-dark mb-2">
              {faq.question}
            </h3>
            <p class="text-xs text-brand-muted leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Cross-Category Navigation -->
    <nav class="pt-6 border-t border-gray-200 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs">
      <span class="font-semibold text-brand-muted">Explore Other Calculation Disciplines:</span>
      <div class="flex flex-wrap gap-2">
        <a href="/converters" class="px-3 py-1.5 bg-white border border-brand-border rounded-lg font-medium hover:border-brand-primary hover:text-brand-primary transition">
          ⇄ Unit Converters
        </a>
        <a href="/math" class="px-3 py-1.5 bg-white border border-brand-border rounded-lg font-medium hover:border-brand-primary hover:text-brand-primary transition">
          ➗ Math & Algebra
        </a>
        <a href="/finance" class="px-3 py-1.5 bg-white border border-brand-border rounded-lg font-medium hover:border-brand-primary hover:text-brand-primary transition">
          💰 Finance & Loans
        </a>
        <a href="/everyday" class="px-3 py-1.5 bg-white border border-brand-border rounded-lg font-medium hover:border-brand-primary hover:text-brand-primary transition">
          📅 Everyday
        </a>
      </div>
    </nav>
  </div>
</BaseLayout>
