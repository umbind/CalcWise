---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CalculationPassport from '../../components/CalculationPassport.astro';
import DateDiffIsland from '../../features/calculators/everyday/DateDiffIsland';
import type { CalculationPassportData } from '../../lib/calculations/types';
import { DATE_DIFF_FORMULA_ID, DATE_DIFF_FORMULA_VERSION } from '../../lib/calculations/date_diff';

const passport: CalculationPassportData = {
  calculatorId: 'date-difference-calculator',
  calculatorName: 'Calendar Date Difference & Working Days Calculator',
  formulaId: DATE_DIFF_FORMULA_ID,
  formulaVersion: DATE_DIFF_FORMULA_VERSION,
  methodology:
    'Measures the precise duration between two calendar dates in days, weeks, months, and years, filtering weekday business days (Monday through Friday) from weekend days.',
  riskTier: 'T0',
  sources: [
    {
      title: 'ISO 8601 Calendar Arithmetic and Standard Day Numbering',
      authority: 'International Organization for Standardization (ISO)',
      url: 'https://www.iso.org/iso-8601-date-and-time-format.html',
    },
  ],
  assumptions: [
    'Business days count Monday through Friday, excluding Saturday and Sunday.',
  ],
  limitations: [
    'Does not automatically deduct local or national bank holidays without regional jurisdiction rules active.',
  ],
  lastReviewed: '2026-09-10',
  reviewerStatus: 'Verified against ISO 8601 Time Interval Specifications',
};
---

<BaseLayout
  title="Date Difference Calculator: Days Between Two Dates & Working Days"
  description="Calculate the exact number of days, weeks, months, and business days between any two dates with custom end-day inclusion."
  breadcrumbs={[
    { label: 'Everyday', href: '/' },
    { label: 'Date Difference Calculator' },
  ]}
  canonicalUrl="https://calcwise.webcalcapps.workers.dev/everyday/date-difference-calculator"
>
  <div class="max-w-4xl mx-auto">
    <div class="mb-8">
      <span class="text-xs font-bold uppercase tracking-wider text-brand-primary">Everyday & Calendar</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-brand-dark tracking-tight mt-1">
        Date Difference & Duration Calculator
      </h1>
      <p class="text-base text-brand-muted mt-2">
        Find the exact number of days, weeks, months, and working business days between any two dates on the calendar.
      </p>
    </div>

    <section aria-label="Date Difference Calculator Widget">
      <DateDiffIsland client:visible />
    </section>

    <article class="mt-12 space-y-8 text-sm text-brand-dark leading-relaxed">
      <CalculationPassport passport={passport} />
    </article>
  </div>
</BaseLayout>
