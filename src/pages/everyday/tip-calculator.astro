---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CalculationPassport from '../../components/CalculationPassport.astro';
import CalculatorActions from '../../components/CalculatorActions';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
import TipIsland from '../../features/calculators/everyday/TipIsland';
import type { CalculationPassportData } from '../../lib/calculations/types';
import { TIP_FORMULA_ID, TIP_FORMULA_VERSION } from '../../lib/calculations/tip';

const passport: CalculationPassportData = {
  calculatorId: 'tip-calculator',
  calculatorName: 'Tip & Bill Splitter Calculator',
  formulaId: TIP_FORMULA_ID,
  formulaVersion: TIP_FORMULA_VERSION,
  methodology:
    'Calculates dining gratuity based on bill subtotal and requested tip percentage, with exact integer party division and optional round-up cent balancing.',
  riskTier: 'T0',
  sources: [
    {
      title: 'Consumer Gratuity Guidelines and Bill Splitting Standards',
      authority: 'National Restaurant Association',
      url: 'https://restaurant.org/',
    },
  ],
  assumptions: [
    'Bill amount is divided equally among all party members.',
  ],
  limitations: [
    'Does not calculate separate line-item individual order split.',
  ],
  lastReviewed: '2026-09-10',
  reviewerStatus: 'Verified against Standard Commercial Billing Arithmetic',
};
---

<BaseLayout
  title="Tip Calculator: Calculate Gratuity & Split Bill Evenly"
  description="Free tip calculator to compute restaurant tips, total checks, and split bills evenly among any number of people with round-up options."
  breadcrumbs={[
    { label: 'Everyday', href: '/everyday' },
    { label: 'Tip Calculator' },
  ]}
  canonicalUrl="https://calcwise.webcalcapps.workers.dev/everyday/tip-calculator"
>
  <div class="max-w-4xl mx-auto">
    <!-- Header Area -->
    <div class="mb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-gray-100">
      <div>
        <span class="text-[10px] font-bold uppercase tracking-wider text-brand-primary">Everyday & Dining</span>
        <h1 class="text-xl sm:text-2xl font-bold text-brand-dark tracking-tight leading-tight">
        Tip & Bill Splitter Calculator
      </h1>
        <p class="text-xs text-brand-muted mt-0.5 max-w-2xl leading-normal">
        Quickly calculate standard gratuity, total check amounts, and split the bill easily between friends or colleagues.
      </p>
      </div>
      <CalculatorActions toolName="Tip & Split" client:idle />
    </div>

    <section aria-label="Tip Calculator Widget">
      <TipIsland client:visible />
    </section>

    <article class="mt-12 space-y-8 text-sm text-brand-dark leading-relaxed">
      <CalculationPassport passport={passport} />

      <!-- Related Calculators -->
      <RelatedCalculators currentSlug="tip-calculator" category="everyday" />
    </article>
  </div>
</BaseLayout>
