---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CalculationPassport from '../../components/CalculationPassport.astro';
import CompoundInterestIsland from '../../features/calculators/finance/CompoundInterestIsland';
import type { CalculationPassportData } from '../../lib/calculations/types';
import { COMPOUND_INTEREST_FORMULA_ID, COMPOUND_INTEREST_FORMULA_VERSION } from '../../lib/calculations/compound_interest';

const passport: CalculationPassportData = {
  calculatorId: 'compound-interest-calculator',
  calculatorName: 'Compound Interest & Growth Calculator',
  formulaId: COMPOUND_INTEREST_FORMULA_ID,
  formulaVersion: COMPOUND_INTEREST_FORMULA_VERSION,
  methodology:
    'Simulates discrete periodic compound interest alongside recurring periodic annuity contributions using arbitrary-precision decimal modeling to prevent compounding rounding errors.',
  riskTier: 'T2',
  sources: [
    {
      title: 'Compound Interest Formula and Future Value of Annuities',
      authority: 'U.S. Securities and Exchange Commission (Investor.gov)',
      url: 'https://www.investor.gov/financial-tools-calculators/calculators/compound-interest-calculator',
    },
  ],
  assumptions: [
    'Annual return is compounded consistently at the chosen frequency.',
    'Contributions are added at regular monthly intervals.',
    'Does not subtract income taxes, capital gains, or inflation adjustment.',
  ],
  limitations: [
    'Market investment returns fluctuate; this model assumes constant average annual growth rate.',
  ],
  lastReviewed: '2026-09-10',
  reviewerStatus: 'Verified by CalcWise Financial Analytics Standards',
  disclaimer:
    'Risk Tier T2 Notice: Investment projections are educational models, not guarantees of actual market performance. Past performance does not guarantee future results.',
};
---

<BaseLayout
  title="Compound Interest Calculator: Calculate Future Value & Growth"
  description="Forecast investment growth, future value, and total interest earned with customizable compounding frequency and regular monthly additions."
  breadcrumbs={[
    { label: 'Finance', href: '/finance/emi-calculator' },
    { label: 'Compound Interest Calculator' },
  ]}
  canonicalUrl="https://calcwise.webcalcapps.workers.dev/finance/compound-interest-calculator"
>
  <div class="max-w-4xl mx-auto">
    <div class="mb-8">
      <span class="text-xs font-bold uppercase tracking-wider text-brand-primary">Finance & Investing</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-brand-dark tracking-tight mt-1">
        Compound Interest Calculator
      </h1>
      <p class="text-base text-brand-muted mt-2">
        See how your money grows over time with compound interest and recurring monthly contributions.
      </p>
    </div>

    <section aria-label="Compound Interest Calculator Widget">
      <CompoundInterestIsland client:visible />
    </section>

    <article class="mt-12 space-y-8 text-sm text-brand-dark leading-relaxed">
      <CalculationPassport passport={passport} />
    </article>
  </div>
</BaseLayout>
