---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CalculationPassport from '../../components/CalculationPassport.astro';
import MortgageIsland from '../../features/calculators/finance/MortgageIsland';
import type { CalculationPassportData } from '../../lib/calculations/types';
import { MORTGAGE_FORMULA_ID, MORTGAGE_FORMULA_VERSION } from '../../lib/calculations/mortgage';

const passport: CalculationPassportData = {
  calculatorId: 'mortgage-calculator',
  calculatorName: 'Residential Mortgage Payment Calculator',
  formulaId: MORTGAGE_FORMULA_ID,
  formulaVersion: MORTGAGE_FORMULA_VERSION,
  methodology:
    'Calculates monthly principal and interest (P&I) using reducing balance amortization, alongside escrow additions for annual property taxes, homeowners insurance, and private mortgage insurance (PMI) when down payment is under 20%.',
  riskTier: 'T2',
  sources: [
    {
      title: 'Consumer Guide to Mortgage Loans and Closing Disclosures',
      authority: 'Consumer Financial Protection Bureau (CFPB)',
      url: 'https://www.consumerfinance.gov/owning-a-home/',
    },
  ],
  assumptions: [
    'Fixed interest rate over the selected loan duration (15, 20, or 30 years).',
    'Standard conventional PMI rate estimated at approximately 0.75% per annum for loan-to-value ratios exceeding 80%.',
  ],
  limitations: [
    'Does not include closing costs, title fees, or transfer taxes in upfront calculations.',
  ],
  lastReviewed: '2026-09-10',
  reviewerStatus: 'Verified against CFPB Mortgage Disclosure Models',
  disclaimer:
    'Risk Tier T2 Notice: Calculations are estimates for planning and comparison. Official loan costs, APR, and qualification require formal underwriting by a licensed mortgage lender.',
};
---

<BaseLayout
  title="Mortgage Calculator: Calculate Monthly Payment, Taxes, Insurance & PMI"
  description="Estimate total monthly mortgage payments with principal, interest, property taxes, homeowners insurance, and PMI breakdown."
  breadcrumbs={[
    { label: 'Finance', href: '/finance/emi-calculator' },
    { label: 'Mortgage Calculator' },
  ]}
  canonicalUrl="https://calcwise.com/finance/mortgage-calculator"
>
  <div class="max-w-4xl mx-auto">
    <div class="mb-8">
      <span class="text-xs font-bold uppercase tracking-wider text-brand-primary">Finance & Real Estate</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-brand-dark tracking-tight mt-1">
        Mortgage Calculator
      </h1>
      <p class="text-base text-brand-muted mt-2">
        See your complete estimated monthly housing payment including principal, interest, taxes, insurance, and PMI.
      </p>
    </div>

    <section aria-label="Mortgage Calculator Widget">
      <MortgageIsland client:visible />
    </section>

    <article class="mt-12 space-y-8 text-sm text-brand-dark leading-relaxed">
      <CalculationPassport passport={passport} />
    </article>
  </div>
</BaseLayout>
