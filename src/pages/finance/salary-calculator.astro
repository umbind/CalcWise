---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CalculationPassport from '../../components/CalculationPassport.astro';
import SalaryIsland from '../../features/calculators/finance/SalaryIsland';
import type { CalculationPassportData } from '../../lib/calculations/types';
import { SALARY_FORMULA_ID, SALARY_FORMULA_VERSION } from '../../lib/calculations/salary';

const passport: CalculationPassportData = {
  calculatorId: 'salary-calculator',
  calculatorName: 'Salary & Wage Conversion Calculator',
  formulaId: SALARY_FORMULA_ID,
  formulaVersion: SALARY_FORMULA_VERSION,
  methodology:
    'Normalizes pay rates into an annualized gross baseline accounting for standard work hours per week and weeks per year, then derives equivalent hourly, weekly, bi-weekly, semi-monthly, and monthly figures.',
  riskTier: 'T1',
  sources: [
    {
      title: 'Fair Labor Standards Act (FLSA) Hours Worked and Overtime Pay Standards',
      authority: 'U.S. Department of Labor (DOL)',
      url: 'https://www.dol.gov/agencies/whd/flsa',
    },
  ],
  assumptions: [
    'Standard full-time employment assumes 40 hours per week across 52 weeks per year (2,080 annual working hours).',
    'Gross pay before mandatory payroll tax deductions, FICA, healthcare, or 401(k) withholdings.',
  ],
  limitations: [
    'Actual take-home paycheck amounts will vary based on federal, state, and local income tax withholding brackets.',
  ],
  lastReviewed: '2026-09-10',
  reviewerStatus: 'Verified against U.S. DOL Standard Pay Period Definitions',
};
---

<BaseLayout
  title="Salary Calculator: Convert Hourly to Salary, Weekly & Monthly"
  description="Convert your wage between hourly, daily, weekly, bi-weekly, monthly, and annual earnings with customizable work hours and weeks per year."
  breadcrumbs={[
    { label: 'Finance', href: '/finance/emi-calculator' },
    { label: 'Salary Calculator' },
  ]}
  canonicalUrl="https://calcwise.com/finance/salary-calculator"
>
  <div class="max-w-4xl mx-auto">
    <div class="mb-8">
      <span class="text-xs font-bold uppercase tracking-wider text-brand-primary">Finance & Career</span>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-brand-dark tracking-tight mt-1">
        Salary & Wage Calculator
      </h1>
      <p class="text-base text-brand-muted mt-2">
        Easily convert your pay between hourly wages, weekly paychecks, bi-weekly pay periods, monthly salary, and total annual earnings.
      </p>
    </div>

    <section aria-label="Salary Calculator Widget">
      <SalaryIsland client:visible />
    </section>

    <article class="mt-12 space-y-8 text-sm text-brand-dark leading-relaxed">
      <CalculationPassport passport={passport} />
    </article>
  </div>
</BaseLayout>
