---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CalculationPassport from '../../components/CalculationPassport.astro';
import CalculatorActions from '../../components/CalculatorActions';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
import SimpleInterestIsland from '../../features/calculators/finance/SimpleInterestIsland';
import type { CalculationPassportData } from '../../lib/calculations/types';
import { SIMPLE_INTEREST_FORMULA_ID, SIMPLE_INTEREST_FORMULA_VERSION } from '../../lib/calculations/simple_interest';

const passport: CalculationPassportData = {
  calculatorId: 'simple-interest-calculator',
  calculatorName: 'Simple Interest Calculator',
  formulaId: SIMPLE_INTEREST_FORMULA_ID,
  formulaVersion: SIMPLE_INTEREST_FORMULA_VERSION,
  methodology:
    'Computes non-compounding linear interest on principal using the standard formula I = (P × R × T) / 100 with exact decimal arithmetic.',
  riskTier: 'T1',
  sources: [
    {
      title: 'Elementary Financial Mathematics: Simple vs Compound Interest',
      authority: 'Federal Reserve Bank Educational Resources',
      url: 'https://www.stlouisfed.org/education',
    },
  ],
  assumptions: [
    'Interest is non-compounding and accrues in direct linear proportion to time.',
  ],
  limitations: [
    'Most long-term consumer bank savings and modern loans compound periodically; refer to the Compound Interest or EMI calculator for compounding schedules.',
  ],
  lastReviewed: '2026-09-10',
  reviewerStatus: 'Verified by CalcWise Financial Modeling Standards',
};
---

<BaseLayout
  title="Simple Interest Calculator: Calculate Interest (P × R × T)"
  description="Quickly calculate linear simple interest and total repayment amounts with step-by-step mathematical formulas."
  breadcrumbs={[
    { label: 'Finance', href: '/finance' },
    { label: 'Simple Interest Calculator' },
  ]}
  canonicalUrl="https://calcwise.webcalcapps.workers.dev/finance/simple-interest-calculator"
>
  <div class="max-w-4xl mx-auto">
    <!-- Header Area -->
    <div class="mb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-gray-100">
      <div>
        <span class="text-[10px] font-bold uppercase tracking-wider text-brand-primary">Finance & Basic Loans</span>
        <h1 class="text-xl sm:text-2xl font-bold text-brand-dark tracking-tight leading-tight">
        Simple Interest Calculator
      </h1>
        <p class="text-xs text-brand-muted mt-0.5 max-w-2xl leading-normal">
        Find the interest earned or owed over time on short-term loans, bonds, or promissory notes without compounding.
      </p>
      </div>
      <CalculatorActions toolName="Simple Interest" client:idle />
    </div>

    <section aria-label="Simple Interest Calculator Widget">
      <SimpleInterestIsland client:visible />
    </section>

    <article class="mt-12 space-y-8 text-sm text-brand-dark leading-relaxed">
      <CalculationPassport passport={passport} />

      <!-- Related Calculators -->
      <RelatedCalculators currentSlug="simple-interest-calculator" category="finance" />
    </article>
  </div>
</BaseLayout>
