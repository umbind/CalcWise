---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCategoryMetadata, getCalculatorsByCategory } from '../../lib/calculations/registry';

const category = getCategoryMetadata('health');
if (!category) throw new Error('Category metadata for health not found');

const calculators = getCalculatorsByCategory('health');

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: category.faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${category.name} - CalcWise`,
  description: category.description,
  url: `https://calcwise.webcalcapps.workers.dev${category.route}/`,
  hasPart: calculators.map((calc) => ({
    '@type': 'WebApplication',
    name: calc.name,
    url: `https://calcwise.webcalcapps.workers.dev${calc.route}/`,
    applicationCategory: 'HealthApplication',
    operatingSystem: 'All',
  })),
};
---

<BaseLayout
  title={`${category.name}: BMI, BMR & Calorie Screening Tools`}
  description={category.description}
  breadcrumbs={[{ label: category.shortName }]}
  canonicalUrl={`https://calcwise.webcalcapps.workers.dev${category.route}/`}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(collectionSchema)} />

  <div class="max-w-5xl mx-auto space-y-12">
    <!-- Category Hero Header -->
    <header class="text-center sm:text-left border-b border-gray-200 pb-8">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
        <div class="flex items-center space-x-3 justify-center sm:justify-start">
          <span class="text-4xl p-2.5 bg-white border border-brand-border rounded-2xl shadow-2xs">
            {category.icon}
          </span>
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-brand-primary">
              Category Hub
            </span>
            <h1 class="text-2xl sm:text-3xl font-black text-brand-dark tracking-tight">
              {category.name}
            </h1>
          </div>
        </div>

        <div class="flex items-center space-x-2 self-center sm:self-auto">
          <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200">
            <span class="w-2 h-2 rounded-full bg-emerald-500 mr-1.5"></span>
            {calculators.length} Clinical Screening Tools
          </span>
          <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-bold bg-amber-50 text-amber-800 border border-amber-200">
            Tier T2 Risk Governed
          </span>
        </div>
      </div>

      <p class="text-base text-brand-muted leading-relaxed max-w-3xl">
        {category.description}
      </p>

      <!-- Risk Disclaimer Notice -->
      <div class="mt-4 p-3.5 bg-amber-50/60 border border-amber-200 rounded-xl text-xs text-amber-900 flex items-start space-x-2.5">
        <span class="text-base">⚠️</span>
        <div>
          <strong class="font-bold">Informational Screening Notice:</strong> Health and metabolic tools on CalcWise provide estimates based on general adult population literature. They are not intended as diagnostic tools or medical prescriptions. Consult a licensed medical professional for personal clinical advice.
        </div>
      </div>
    </header>

    <!-- Calculator Grid -->
    <section aria-labelledby="tools-list-heading">
      <div class="flex justify-between items-baseline mb-6">
        <h2 id="tools-list-heading" class="text-xl font-bold text-brand-dark tracking-tight">
          Metabolic & Wellness Calculators
        </h2>
        <span class="text-xs text-brand-muted font-medium">WHO & Mifflin-St Jeor Standards</span>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
        {calculators.map((calc) => (
          <a
            href={calc.route}
            title={calc.description}
            class="bg-gradient-to-br from-rose-50/80 via-white to-pink-50/50 border border-rose-200/90 rounded-xl px-3.5 py-2.5 hover:border-rose-500 hover:shadow-md hover:-translate-y-0.5 transition-all flex items-center justify-between group"
          >
            <div class="flex items-center space-x-2.5 min-w-0 pr-2">
              <span class="w-8 h-8 rounded-lg bg-rose-100 text-rose-800 flex items-center justify-center text-base shrink-0 group-hover:scale-110 transition-transform shadow-2xs">
                {calc.icon}
              </span>
              <div class="min-w-0">
                <h3 class="font-bold text-sm text-rose-950 group-hover:text-rose-700 transition truncate leading-tight">
                  {calc.name}
                </h3>
                <span class="text-[10px] font-mono text-rose-400 block truncate -mt-0.5">
                  ID: {calc.id}
                </span>
              </div>
            </div>
            <span class="px-1.5 py-0.5 text-[9px] font-extrabold rounded bg-rose-100 text-rose-700 border border-rose-200 shrink-0">
              {calc.riskTier}
            </span>
          </a>
        ))}
      </div>
    </section>

    <!-- Clinical Standards & Governance -->
    <section class="bg-white rounded-2xl border border-brand-border p-6 sm:p-8 space-y-6 shadow-2xs">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-brand-primary">
          Physiological Literature & Formula Governance
        </span>
        <h2 class="text-xl font-black text-brand-dark tracking-tight mt-1">
          Evidence-Based Health Estimation Models
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs text-brand-dark leading-relaxed">
        <div class="space-y-3">
          <h3 class="font-bold text-sm text-brand-dark">The Mifflin-St Jeor Metabolic Standard</h3>
          <p class="text-brand-muted">
            Energy expenditure equations estimate the resting metabolic rate (BMR) required to sustain vital bodily functions at rest. CalcWise implements the 1990 Mifflin-St Jeor equation, which clinical systematic reviews by the Academy of Nutrition and Dietetics established as the most reliable predictive formula for modern populations.
          </p>
          <div class="bg-brand-surface p-3 rounded-lg border border-gray-200 font-mono text-[11px] text-brand-primary">
            Men: (10 × wt_kg) + (6.25 × ht_cm) - (5 × age) + 5<br/>
            Women: (10 × wt_kg) + (6.25 × ht_cm) - (5 × age) - 161
          </div>
        </div>

        <div class="space-y-3">
          <h3 class="font-bold text-sm text-brand-dark">World Health Organization (WHO) Cutoffs</h3>
          <p class="text-brand-muted">
            Our Body Mass Index calculators adhere strictly to the WHO international anthropometric classifications: Underweight (&lt; 18.5), Normal Weight (18.5–24.9), Overweight (25.0–29.9), and Obese (≥ 30.0), alongside healthy weight range reverse calculations.
          </p>
          <div class="p-3.5 bg-brand-surface rounded-xl border border-gray-200">
            <span class="font-semibold text-brand-dark block mb-1">Governing Authorities:</span>
            <span class="text-brand-muted text-[11px] block">{category.standardsBody}</span>
            <span class="text-[11px] text-brand-muted mt-1 block">{category.standardsSummary}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Category FAQs -->
    <section class="space-y-4" aria-labelledby="category-faq-heading">
      <h2 id="category-faq-heading" class="text-xl font-bold text-brand-dark tracking-tight">
        Frequently Asked Questions
      </h2>

      <div class="space-y-3">
        {category.faqs.map((faq) => (
          <div class="bg-white border border-brand-border rounded-xl p-5 shadow-2xs">
            <h3 class="font-bold text-sm text-brand-dark mb-2">
              {faq.question}
            </h3>
            <p class="text-xs text-brand-muted leading-relaxed">
              {faq.answer}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Cross-Category Navigation -->
    <nav class="pt-6 border-t border-gray-200 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs">
      <span class="font-semibold text-brand-muted">Explore Other Calculation Disciplines:</span>
      <div class="flex flex-wrap gap-2">
        <a href="/finance" class="px-3 py-1.5 bg-white border border-brand-border rounded-lg font-medium hover:border-brand-primary hover:text-brand-primary transition">
          💰 Finance & Borrowing
        </a>
        <a href="/math" class="px-3 py-1.5 bg-white border border-brand-border rounded-lg font-medium hover:border-brand-primary hover:text-brand-primary transition">
          ➗ Math & Algebra
        </a>
        <a href="/converters" class="px-3 py-1.5 bg-white border border-brand-border rounded-lg font-medium hover:border-brand-primary hover:text-brand-primary transition">
          ⇄ Unit Converters
        </a>
        <a href="/everyday" class="px-3 py-1.5 bg-white border border-brand-border rounded-lg font-medium hover:border-brand-primary hover:text-brand-primary transition">
          📅 Everyday
        </a>
      </div>
    </nav>
  </div>
</BaseLayout>
