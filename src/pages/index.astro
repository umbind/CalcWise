---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CALCULATOR_REGISTRY } from '../lib/calculations/registry';

const categories = [
  { id: 'finance', name: 'Finance & Money', icon: '💰', count: `${CALCULATOR_REGISTRY.filter(c => c.category === 'finance').length} Tools` },
  { id: 'health', name: 'Health & Fitness', icon: '❤️', count: `${CALCULATOR_REGISTRY.filter(c => c.category === 'health').length} Tools` },
  { id: 'math', name: 'Math & Algebra', icon: '➗', count: `${CALCULATOR_REGISTRY.filter(c => c.category === 'math').length} Tools` },
  { id: 'construction', name: 'Construction & Materials', icon: '🏗️', count: `${CALCULATOR_REGISTRY.filter(c => c.category === 'construction').length} Tools` },
  { id: 'converters', name: 'Conversions & Units', icon: '⇄', count: `${CALCULATOR_REGISTRY.filter(c => c.category === 'converters').length} Tools` },
  { id: 'everyday', name: 'Everyday & Calendar', icon: '📅', count: `${CALCULATOR_REGISTRY.filter(c => c.category === 'everyday').length} Tools` },
];

const categoryCardStyles: Record<string, { bg: string; border: string; iconBg: string; text: string; badge: string; link: string }> = {
  finance: {
    bg: 'bg-gradient-to-br from-blue-50/80 via-white to-indigo-50/50',
    border: 'border-blue-200/90 hover:border-blue-500',
    iconBg: 'bg-blue-100 text-blue-800',
    text: 'text-blue-950 group-hover:text-blue-700',
    badge: 'bg-blue-100 text-blue-700 border-blue-200',
    link: 'text-blue-700 group-hover:text-blue-900',
  },
  health: {
    bg: 'bg-gradient-to-br from-rose-50/80 via-white to-pink-50/50',
    border: 'border-rose-200/90 hover:border-rose-500',
    iconBg: 'bg-rose-100 text-rose-800',
    text: 'text-rose-950 group-hover:text-rose-700',
    badge: 'bg-rose-100 text-rose-700 border-rose-200',
    link: 'text-rose-700 group-hover:text-rose-900',
  },
  math: {
    bg: 'bg-gradient-to-br from-purple-50/80 via-white to-violet-50/50',
    border: 'border-purple-200/90 hover:border-purple-500',
    iconBg: 'bg-purple-100 text-purple-800',
    text: 'text-purple-950 group-hover:text-purple-700',
    badge: 'bg-purple-100 text-purple-700 border-purple-200',
    link: 'text-purple-700 group-hover:text-purple-900',
  },
  construction: {
    bg: 'bg-gradient-to-br from-amber-50/80 via-white to-orange-50/50',
    border: 'border-amber-200/90 hover:border-amber-500',
    iconBg: 'bg-amber-100 text-amber-800',
    text: 'text-amber-950 group-hover:text-amber-700',
    badge: 'bg-amber-100 text-amber-800 border-amber-200',
    link: 'text-amber-700 group-hover:text-amber-900',
  },
  everyday: {
    bg: 'bg-gradient-to-br from-sky-50/80 via-white to-cyan-50/50',
    border: 'border-sky-200/90 hover:border-sky-500',
    iconBg: 'bg-sky-100 text-sky-800',
    text: 'text-sky-950 group-hover:text-sky-700',
    badge: 'bg-sky-100 text-sky-700 border-sky-200',
    link: 'text-sky-700 group-hover:text-sky-900',
  },
  converters: {
    bg: 'bg-gradient-to-br from-emerald-50/80 via-white to-teal-50/50',
    border: 'border-emerald-200/90 hover:border-emerald-500',
    iconBg: 'bg-emerald-100 text-emerald-800',
    text: 'text-emerald-950 group-hover:text-emerald-700',
    badge: 'bg-emerald-100 text-emerald-700 border-emerald-200',
    link: 'text-emerald-700 group-hover:text-emerald-900',
  },
};
---

<BaseLayout
  title="CalcWise: Fast, Verifiable, and Transparent Calculations"
  description="CalcWise is the decision-first calculation platform with inspectable Calculation Passports, step-by-step mathematical traces, and zero-JS performance."
  canonicalUrl="https://calcwise.webcalcapps.workers.dev/"
>
  <!-- Compact Vibrant Hero Section -->
  <div class="text-center max-w-2xl mx-auto pt-1 pb-4">
    <div class="inline-flex items-center space-x-1.5 px-3 py-0.5 rounded-full text-[11px] font-semibold bg-gradient-to-r from-blue-50 to-emerald-50 border border-brand-primary/20 text-brand-primary mb-2 shadow-2xs">
      <span class="text-amber-500">✨</span>
      <span>50 Verified High-Precision Calculators Active</span>
    </div>

    <h1 class="text-2xl sm:text-3xl font-black text-brand-dark tracking-tight leading-snug">
      Calculate with <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-primary to-blue-600">Precision</span>. Decide with <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-accent to-emerald-500">Confidence</span>.
    </h1>

    <!-- Colorful High-Intent Search Box -->
    <div class="mt-3.5 max-w-lg mx-auto relative">
      <div class="relative p-[1.5px] rounded-xl bg-gradient-to-r from-brand-primary/40 via-purple-500/30 to-brand-accent/40 hover:from-brand-primary hover:via-purple-500 hover:to-brand-accent transition-all shadow-2xs hover:shadow-sm">
        <div class="relative bg-white rounded-[10px] flex items-center">
          <span class="pl-3.5 text-base text-brand-primary">🔍</span>
          <input
            type="text"
            id="tool-search"
            placeholder="Search 50 calculators (e.g. loan, bmi, percentage, paint, age)..."
            class="w-full pl-3 pr-4 py-2.5 bg-transparent rounded-[10px] text-xs sm:text-sm text-brand-dark placeholder-gray-400 focus:outline-none"
          />
          <span class="pr-3 text-[10px] text-gray-400 font-mono hidden sm:inline-block">↵ Enter</span>
        </div>
      </div>

      <!-- Colorful Category-Coded Quick Picks -->
      <div class="flex flex-wrap items-center justify-center gap-1.5 mt-2.5 text-[11px]">
        <span class="text-gray-400 font-medium">Trending:</span>
        <a href="/finance/emi-calculator" class="px-2 py-0.5 rounded-full bg-blue-50 hover:bg-blue-100 text-blue-700 border border-blue-200/70 font-medium transition">💰 EMI Loan</a>
        <a href="/health/bmi-calculator" class="px-2 py-0.5 rounded-full bg-emerald-50 hover:bg-emerald-100 text-emerald-700 border border-emerald-200/70 font-medium transition">❤️ BMI</a>
        <a href="/finance/compound-interest-calculator" class="px-2 py-0.5 rounded-full bg-purple-50 hover:bg-purple-100 text-purple-700 border border-purple-200/70 font-medium transition">📈 Compound Interest</a>
        <a href="/construction/concrete-calculator" class="px-2 py-0.5 rounded-full bg-amber-50 hover:bg-amber-100 text-amber-700 border border-amber-200/70 font-medium transition">🏗️ Concrete</a>
        <a href="/everyday/age-calculator" class="px-2 py-0.5 rounded-full bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200/70 font-medium transition">📅 Age</a>
      </div>
    </div>

    <!-- Supporting Normal Subtext (Credibility Anchor) -->
    <p class="text-xs text-brand-muted mt-3 leading-normal max-w-lg mx-auto">
      Deterministic calculation engines with inspectable formulas, step-by-step traces, and verified Calculation Passports.
    </p>
  </div>

  <!-- Category Browse Hubs -->
  <section class="mt-2 mb-10" aria-labelledby="categories-heading">
    <h2 id="categories-heading" class="text-lg font-bold text-brand-dark tracking-tight mb-3">
      Explore Categories
    </h2>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
      {categories.map((cat) => (
        <a
          href={`/${cat.id}`}
          class="bg-white rounded-xl border border-brand-border p-4 text-center hover:border-brand-primary hover:shadow-2xs transition group"
        >
          <div class="text-2xl mb-1.5">{cat.icon}</div>
          <div class="font-bold text-xs text-brand-dark group-hover:text-brand-primary transition">{cat.name}</div>
          <div class="text-[10px] text-brand-muted mt-0.5">{cat.count}</div>
        </a>
      ))}
    </div>
  </section>

  <!-- Complete 20-Calculator Catalog Grouped by Category -->
  <section class="space-y-12" aria-labelledby="all-tools-heading">
    <div class="border-b border-gray-200 pb-3 flex justify-between items-baseline">
      <h2 id="all-tools-heading" class="text-2xl font-black text-brand-dark tracking-tight">
        All 20 Alpha Calculators
      </h2>
      <span class="text-xs font-semibold text-brand-primary">100% Tested with Golden Datasets</span>
    </div>

    {categories.map((cat) => {
      const tools = CALCULATOR_REGISTRY.filter(t => t.category === cat.id);
      if (tools.length === 0) return null;
      return (
        <div id={`category-${cat.id}`} class="scroll-mt-20">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
            <div class="flex items-center space-x-2">
              <span class="text-xl">{cat.icon}</span>
              <h3 class="text-lg font-bold text-brand-dark">{cat.name}</h3>
              <span class="text-xs text-brand-muted font-normal">({tools.length} calculators)</span>
            </div>
            <a
              href={`/${cat.id}`}
              class="text-xs font-semibold text-brand-primary hover:text-brand-accent transition inline-flex items-center space-x-1 self-start sm:self-auto"
            >
              <span>Explore {cat.name} Hub</span>
              <span>→</span>
            </a>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
            {tools.map((tool) => {
              const style = categoryCardStyles[cat.id] || categoryCardStyles.finance;
              return (
                <a
                  href={tool.route}
                  title={tool.description}
                  class={`${style.bg} rounded-xl border ${style.border} px-3.5 py-2.5 shadow-2xs hover:shadow-md hover:-translate-y-0.5 transition-all flex items-center justify-between group`}
                >
                  <div class="flex items-center space-x-2.5 min-w-0 pr-2">
                    <span class={`w-8 h-8 rounded-lg ${style.iconBg} flex items-center justify-center text-base shrink-0 group-hover:scale-110 transition-transform shadow-2xs`}>
                      {tool.icon}
                    </span>
                    <div class="min-w-0">
                      <h4 class={`text-sm font-bold ${style.text} transition truncate leading-tight`}>
                        {tool.name}
                      </h4>
                      <span class="text-[10px] font-mono opacity-60 block truncate -mt-0.5">
                        ID: {tool.id}
                      </span>
                    </div>
                  </div>
                  <span class={`text-[9px] font-extrabold px-1.5 py-0.5 rounded ${style.badge} shrink-0`}>
                    {tool.riskTier}
                  </span>
                </a>
              );
            })}
          </div>
        </div>
      );
    })}
  </section>

  <!-- The CalcWise Trust Advantage -->
  <section class="mt-16 bg-white rounded-2xl border border-brand-border p-8 shadow-sm">
    <div class="max-w-2xl">
      <span class="text-xs font-bold uppercase tracking-wider text-brand-primary">The CalcWise Standard</span>
      <h2 class="text-2xl font-black text-brand-dark mt-1">Why CalcWise is Built Differently</h2>
      <p class="text-xs sm:text-sm text-brand-muted mt-2 leading-relaxed">
        Most web calculators operate as black boxes, hiding formulas and rounding unpredictably. CalcWise operates on five non-negotiable principles:
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 mt-8">
      <div class="p-4 bg-brand-surface rounded-xl border border-gray-200">
        <div class="w-8 h-8 rounded-lg bg-brand-primary text-white flex items-center justify-center font-bold text-sm mb-3">1</div>
        <h3 class="font-bold text-sm text-brand-dark">Calculation Passport</h3>
        <p class="text-xs text-brand-muted mt-1 leading-relaxed">Every calculator displays its formula version, authoritative sources, assumptions, and last audited date.</p>
      </div>

      <div class="p-4 bg-brand-surface rounded-xl border border-gray-200">
        <div class="w-8 h-8 rounded-lg bg-brand-primary text-white flex items-center justify-center font-bold text-sm mb-3">2</div>
        <h3 class="font-bold text-sm text-brand-dark">Show Your Work</h3>
        <p class="text-xs text-brand-muted mt-1 leading-relaxed">Inspect step-by-step mathematical proofs showing every substitution, conversion, and rounding operation.</p>
      </div>

      <div class="p-4 bg-brand-surface rounded-xl border border-gray-200">
        <div class="w-8 h-8 rounded-lg bg-brand-primary text-white flex items-center justify-center font-bold text-sm mb-3">3</div>
        <h3 class="font-bold text-sm text-brand-dark">Zero-JS Performance</h3>
        <p class="text-xs text-brand-muted mt-1 leading-relaxed">Built with Astro islands for instant page loads, strict &le;75KB JavaScript budgets, and 100% WCAG 2.2 AA accessibility.</p>
      </div>
    </div>
  </section>

  <!-- Live instant search script -->
  <script is:inline define:vars={{ registry: CALCULATOR_REGISTRY }}>
    const searchInput = document.getElementById('tool-search');
    if (searchInput) {
      searchInput.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') {
          const q = searchInput.value.toLowerCase().trim();
          if (!q) return;
          const match = registry.find(t => 
            t.name.toLowerCase().includes(q) || 
            t.slug.toLowerCase().includes(q) || 
            t.keywords.some(k => k.includes(q))
          );
          if (match) {
            window.location.href = match.route;
          }
        }
      });
    }
  </script>
</BaseLayout>
