---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CalculationPassport from '../../components/CalculationPassport.astro';
import CalculatorActions from '../../components/CalculatorActions';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
import AverageIsland from '../../features/calculators/math/AverageIsland';
import type { CalculationPassportData } from '../../lib/calculations/types';
import { AVERAGE_FORMULA_ID, AVERAGE_FORMULA_VERSION } from '../../lib/calculations/average';

const passport: CalculationPassportData = {
  calculatorId: 'average-calculator',
  calculatorName: 'Descriptive Statistics & Average Calculator',
  formulaId: AVERAGE_FORMULA_ID,
  formulaVersion: AVERAGE_FORMULA_VERSION,
  methodology:
    'Computes primary measures of central tendency (mean, median, mode) and dispersion (range, sample standard deviation, population standard deviation) on numeric datasets using exact arbitrary-precision arithmetic.',
  riskTier: 'T0',
  sources: [
    {
      title: 'NIST/SEMATECH e-Handbook of Statistical Methods: Measures of Central Tendency',
      authority: 'National Institute of Standards and Technology',
      url: 'https://www.itl.nist.gov/div898/handbook/',
    },
  ],
  assumptions: [
    'Sample standard deviation uses Bessel correction factor (N - 1) in denominator.',
    'Population standard deviation divides by total count (N).',
  ],
  limitations: [
    'Assumes finite numeric values.',
  ],
  lastReviewed: '2026-09-10',
  reviewerStatus: 'Verified against NIST Statistical Reference Datasets',
};
---

<BaseLayout
  title="Average Calculator: Calculate Mean, Median, Mode & Standard Deviation"
  description="Free average calculator to find arithmetic mean, median, mode, range, sum, count, and standard deviation for any dataset."
  breadcrumbs={[
    { label: 'Math', href: '/math' },
    { label: 'Average Calculator' },
  ]}
  canonicalUrl="https://calcwise.webcalcapps.workers.dev/math/average-calculator"
>
  <div class="max-w-4xl mx-auto">
    <!-- Header Area -->
    <div class="mb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-gray-100">
      <div>
        <span class="text-[10px] font-bold uppercase tracking-wider text-brand-primary">Math & Statistics</span>
        <h1 class="text-xl sm:text-2xl font-bold text-brand-dark tracking-tight leading-tight">
        Average (Mean, Median, Mode) Calculator
      </h1>
        <p class="text-xs text-brand-muted mt-0.5 max-w-2xl leading-normal">
        Enter a list of numbers to instantly compute the average (mean), middle number (median), most common value (mode), and standard deviation.
      </p>
      </div>
      <CalculatorActions toolName="Average & Mean" client:idle />
    </div>

    <section aria-label="Average Calculator Widget">
      <AverageIsland client:visible />
    </section>

    <article class="mt-12 space-y-8 text-sm text-brand-dark leading-relaxed">
      <CalculationPassport passport={passport} />

      <!-- Related Calculators -->
      <RelatedCalculators currentSlug="average-calculator" category="math" />
    </article>
  </div>
</BaseLayout>
