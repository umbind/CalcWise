---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CalculationPassport from '../../components/CalculationPassport.astro';
import CalculatorActions from '../../components/CalculatorActions';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
import FractionIsland from '../../features/calculators/math/FractionIsland';
import type { CalculationPassportData } from '../../lib/calculations/types';
import { FRACTION_FORMULA_ID, FRACTION_FORMULA_VERSION } from '../../lib/calculations/fraction';

const passport: CalculationPassportData = {
  calculatorId: 'fraction-calculator',
  calculatorName: 'Rational Fraction Arithmetic Calculator',
  formulaId: FRACTION_FORMULA_ID,
  formulaVersion: FRACTION_FORMULA_VERSION,
  methodology:
    'Executes rational fraction addition, subtraction, multiplication, and reciprocal division, reducing results to simplest form via Euclidean Greatest Common Divisor (GCD) factoring.',
  riskTier: 'T0',
  sources: [
    {
      title: 'Euclidean Algorithm for Greatest Common Divisors',
      authority: 'National Council of Teachers of Mathematics (NCTM)',
      url: 'https://www.nctm.org/',
    },
  ],
  assumptions: [
    'Denominators must be non-zero integers.',
  ],
  limitations: [
    'Limited to rational numbers expressible as integer ratios.',
  ],
  lastReviewed: '2026-09-10',
  reviewerStatus: 'Verified against Rational Number Theory Standards',
};
---

<BaseLayout
  title="Fraction Calculator: Add, Subtract, Multiply & Divide Fractions"
  description="Free online fraction calculator to add, subtract, multiply, and divide fractions with automated common denominators, mixed number conversion, and step-by-step reduction."
  breadcrumbs={[
    { label: 'Math', href: '/math' },
    { label: 'Fraction Calculator' },
  ]}
  canonicalUrl="https://calcwise.webcalcapps.workers.dev/math/fraction-calculator"
>
  <div class="max-w-4xl mx-auto">
    <!-- Header Area -->
    <div class="mb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-gray-100">
      <div>
        <span class="text-[10px] font-bold uppercase tracking-wider text-brand-primary">Math & Arithmetic</span>
        <h1 class="text-xl sm:text-2xl font-bold text-brand-dark tracking-tight leading-tight">
        Fraction Calculator
      </h1>
        <p class="text-xs text-brand-muted mt-0.5 max-w-2xl leading-normal">
        Add, subtract, multiply, or divide fractions with automated common denominators, step-by-step GCD reduction, and mixed number conversions.
      </p>
      </div>
      <CalculatorActions toolName="Fraction" client:idle />
    </div>

    <section aria-label="Fraction Calculator Widget">
      <FractionIsland client:visible />
    </section>

    <article class="mt-12 space-y-8 text-sm text-brand-dark leading-relaxed">
      <CalculationPassport passport={passport} />

      <!-- Related Calculators -->
      <RelatedCalculators currentSlug="fraction-calculator" category="math" />
    </article>
  </div>
</BaseLayout>
