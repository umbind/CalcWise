---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CalculationPassport from '../../components/CalculationPassport.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
import CalculatorActions from '../../components/CalculatorActions';
import LogarithmIsland from '../../features/calculators/math/LogarithmIsland';
import type { CalculationPassportData } from '../../lib/calculations/types';
import { LOG_FORMULA_ID, LOG_FORMULA_VERSION } from '../../lib/calculations/logarithm';

const passport: CalculationPassportData = {
  calculatorId: 'logarithm-calculator',
  calculatorName: 'Logarithm (ln, log10, log2, log_b) Calculator',
  formulaId: LOG_FORMULA_ID,
  formulaVersion: LOG_FORMULA_VERSION,
  methodology:
    'Evaluates arbitrary base logarithms log_b(x) using the continuous change-of-base formula log_b(x) = ln(x) / ln(b), with simultaneous computation of natural (base e), decadic common (base 10), and binary (base 2) logarithms.',
  riskTier: 'T1',
  sources: [
    {
      title: 'Elementary Transcendental Functions: The Logarithm',
      authority: 'National Institute of Standards and Technology (NIST DLMF)',
      url: 'https://dlmf.nist.gov/4.2',
    },
    {
      title: 'Properties of Logarithms and Change of Base Theorem',
      authority: 'OpenStax Precalculus',
      url: 'https://openstax.org/details/books/precalculus-2e',
    },
  ],
  assumptions: [
    'Argument x must be strictly greater than zero (x > 0).',
    'Base b must be positive and not equal to 1 (b > 0, b ≠ 1).',
  ],
  limitations: [
    'Evaluates real branches of logarithmic functions only (complex branches omitted).',
  ],
  lastReviewed: '2026-09-12',
  reviewerStatus: 'Verified by CalcWise Mathematical Standards',
  disclaimer:
    'This calculator is designed for academic, scientific, acoustic (dB), information theoretic (bits), and chemical (pH) calculations with verified continuous precision.',
};
---

<BaseLayout
  title="Logarithm Calculator: log10, ln, log2 & Custom Base"
  description="Calculate logarithms with any base log_b(x), natural log ln(x), common log log10(x), and binary log log2(x) with verified precision."
  breadcrumbs={[
    { label: 'Math', href: '/math' },
    { label: 'Logarithm Calculator' },
  ]}
  canonicalUrl="https://calcwise.webcalcapps.workers.dev/math/logarithm-calculator"
>
  <div class="max-w-4xl mx-auto">
    <!-- Header Area -->
    <div class="mb-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-gray-100">
      <div>
        <span class="text-[10px] font-bold uppercase tracking-wider text-brand-primary">Algebra & Transcendental Functions</span>
        <h1 class="text-xl sm:text-2xl font-bold text-brand-dark tracking-tight leading-tight">
          Logarithm Calculator
        </h1>
        <p class="text-xs text-brand-muted mt-0.5 max-w-2xl leading-normal">
          Calculate logarithms to any base, compute natural logarithms (ln), common logarithms (log₁₀), and binary logs (log₂).
        </p>
      </div>
      <CalculatorActions toolName="Logarithm" client:idle />
    </div>

    <!-- Functional Tool (Above the Fold) -->
    <section aria-label="Logarithm Calculator Widget">
      <LogarithmIsland client:visible />
    </section>

    <!-- Explanatory Knowledge Layer -->
    <article class="mt-12 space-y-8 text-sm text-brand-dark leading-relaxed">
      <div class="bg-white rounded-xl border border-brand-border p-6 shadow-sm">
        <h2 class="text-lg font-bold text-brand-dark mb-3">Understanding the Logarithm</h2>
        <p class="text-brand-muted mb-4">
          A logarithm is the inverse operation to exponentiation. It answers the fundamental question: <em>"To what power must base $b$ be raised to equal $x$?"</em>. By applying the Change-of-Base Theorem, any base logarithm can be evaluated using standard natural logarithms ($\ln$).
        </p>
        <div class="bg-brand-surface p-4 rounded-lg border border-gray-200 font-mono text-xs text-brand-primary">
          <code>log_b(x) = y  ⟺  bʸ = x ;  log_b(x) = ln(x) / ln(b)</code>
        </div>
      </div>

      <!-- Calculation Passport -->
      <CalculationPassport passport={passport} />

      <!-- Related Calculators -->
      <RelatedCalculators currentSlug="logarithm-calculator" category="math" />
    </article>
  </div>
</BaseLayout>
