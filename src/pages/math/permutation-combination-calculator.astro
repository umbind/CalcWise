---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CalculationPassport from '../../components/CalculationPassport.astro';
import RelatedCalculators from '../../components/RelatedCalculators.astro';
import CalculatorActions from '../../components/CalculatorActions';
import PermutationCombinationIsland from '../../features/calculators/math/PermutationCombinationIsland';
import type { CalculationPassportData } from '../../lib/calculations/types';
import { PERM_COMB_FORMULA_ID, PERM_COMB_FORMULA_VERSION } from '../../lib/calculations/permutation_combination';

const passport: CalculationPassportData = {
  calculatorId: 'permutation-combination-calculator',
  calculatorName: 'Permutations & Combinations (nPr / nCr) Calculator',
  formulaId: PERM_COMB_FORMULA_ID,
  formulaVersion: PERM_COMB_FORMULA_VERSION,
  methodology:
    'Computes exact combinatorial subsets and permutations with and without repetition using arbitrary-precision big integer arithmetic: nPr = n! / (n - r)! and nCr = n! / (r!(n - r)!).',
  riskTier: 'T1',
  sources: [
    {
      title: 'Combinatorics and Discrete Mathematics Standards',
      authority: 'Mathematical Association of America (MAA)',
      url: 'https://www.maa.org/',
    },
    {
      title: 'Binomial Coefficients and Permutation Identities',
      authority: 'National Institute of Standards and Technology (NIST DLMF)',
      url: 'https://dlmf.nist.gov/26',
    },
  ],
  assumptions: [
    'n and r must be non-negative integers.',
    'For sampling without repetition, r cannot exceed n.',
    'Arbitrary-precision BigInt prevents floating-point overflow for large factorial calculations.',
  ],
  limitations: [
    'Computations are capped at n ≤ 150 to preserve instantaneous sub-millisecond execution response.',
  ],
  lastReviewed: '2026-09-12',
  reviewerStatus: 'Verified by CalcWise Mathematical Standards',
  disclaimer:
    'This calculator is designed for statistical sampling, probability analysis, discrete mathematics, and computer science applications with verified combinatorial rigor.',
};
---

<BaseLayout
  title="Permutation and Combination Calculator: nPr & nCr"
  description="Calculate permutations (nPr) and combinations (nCr) with or without repetition using verified arbitrary-precision integer mathematics."
  breadcrumbs={[
    { label: 'Math', href: '/math' },
    { label: 'Permutations & Combinations' },
  ]}
  canonicalUrl="https://calcwise.webcalcapps.workers.dev/math/permutation-combination-calculator"
>
  <div class="max-w-4xl mx-auto">
    <!-- Header Area -->
    <div class="mb-6 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
      <div>
        <span class="text-xs font-bold uppercase tracking-wider text-brand-primary">Discrete Math & Probability</span>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-brand-dark tracking-tight mt-1">
          Permutation & Combination Calculator
        </h1>
        <p class="text-base text-brand-muted mt-2">
          Calculate the number of ways to choose and arrange items from a set, with or without order dependency and repetition.
        </p>
      </div>
      <CalculatorActions toolName="Permutations & Combinations" client:idle />
    </div>

    <!-- Functional Tool (Above the Fold) -->
    <section aria-label="Permutation and Combination Calculator Widget">
      <PermutationCombinationIsland client:visible />
    </section>

    <!-- Explanatory Knowledge Layer -->
    <article class="mt-12 space-y-8 text-sm text-brand-dark leading-relaxed">
      <div class="bg-white rounded-xl border border-brand-border p-6 shadow-sm">
        <h2 class="text-lg font-bold text-brand-dark mb-3">Difference Between Permutations and Combinations</h2>
        <p class="text-brand-muted mb-4">
          In permutations, <strong>order matters</strong> (e.g. locker combinations or race podiums). In combinations, <strong>order does not matter</strong> (e.g. poker hands or committee selections). Choosing 3 people out of 10 for identical positions yields 120 combinations (10C3), but assigning them specific distinct titles yields 720 permutations (10P3).
        </p>
        <div class="bg-brand-surface p-4 rounded-lg border border-gray-200 font-mono text-xs text-brand-primary">
          <code>nPr = n! / (n - r)! ;  nCr = n! / (r! × (n - r)!)</code>
        </div>
      </div>

      <!-- Calculation Passport -->
      <CalculationPassport passport={passport} />

      <!-- Related Calculators -->
      <RelatedCalculators currentSlug="permutation-combination-calculator" category="math" />
    </article>
  </div>
</BaseLayout>
